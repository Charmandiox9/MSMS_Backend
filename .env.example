# ==============================================================================
# AMBIENTE 1: DESARROLLO (npm run start:dev)
# ==============================================================================
# NODE_ENV="development"
#
# -- Base de Datos (Neon) --
# DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require"
#
# -- Almacenamiento de Objetos (Cloudflare R2) --
# STORAGE_PROVIDER="r2"
# R2_ACCOUNT_ID="tu_account_id_de_cloudflare"
# R2_ACCESS_KEY_ID="tu_access_key"
# R2_SECRET_ACCESS_KEY="tu_secret_key"
# R2_BUCKET_NAME="msms-dev-bucket"
#
# -- Caché --
# CACHE_TYPE="memory" # Usa la memoria RAM de Node.js (equivalente backend a localStorage)


# ==============================================================================
# AMBIENTE 2: PRE-PRODUCCIÓN (docker-compose)
# ==============================================================================
# NODE_ENV="preproduction" # Mantendrá el LoggingInterceptor activado
#
# -- Base de Datos (PostgreSQL en Docker) --
# DATABASE_URL="postgresql://user:password@db:5432/msms_db?schema=public"
#
# -- Almacenamiento de Objetos (MinIO en Docker) --
# STORAGE_PROVIDER="minio"
# S3_ENDPOINT="http://minio:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET_NAME="msms-bucket"
#
# -- Caché (Redis en Docker) --
# CACHE_TYPE="redis"
# REDIS_URL="redis://redis:6379"


# ==============================================================================
# AMBIENTE 3: PRODUCCIÓN
# ==============================================================================
# NODE_ENV="production" # Desactiva automáticamente el LoggingInterceptor
#
# -- Base de Datos --
# DATABASE_URL="postgresql://user:password@db_prod:5432/msms_db?schema=public"
#
# -- Almacenamiento de Objetos --
# STORAGE_PROVIDER="s3_or_minio"
# S3_ENDPOINT="..."
#
# -- Caché --
# CACHE_TYPE="redis"
# REDIS_URL="redis://redis:6379"
