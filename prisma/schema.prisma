// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion   Int     @default(0)
  emailHash    String? @unique
  googleIdHash String? @unique

  id        String  @id @default(uuid())
  email     String  @unique
  name      String
  avatarUrl String?

  // Google OAuth specific
  googleId String? @unique

  // Los roles y permisos son configurables y se asignan mediante relaciones RBAC.
  userRoles                    UserRole[]
  createdJustifications        Justification[]              @relation("JustificationCreatedBy")
  decidedJustifications        Justification[]              @relation("JustificationDecidedBy")
  justificationHistory         JustificationStatusHistory[]
  dataRightsRequests           DataRightsRequest[]          @relation("DataRightsSubject")
  dataRightsActions            DataRightsRequestEvent[]     @relation("DataRightsActor")
  legalTermsAcceptances        LegalTermsAcceptance[]
  createdTitulations           TitulationProcess[]          @relation("TitulationCreatedBy")
  updatedTitulations           TitulationProcess[]          @relation("TitulationUpdatedBy")
  createdTitulationAttachments TitulationAttachment[]       @relation("TitulationAttachmentCreatedBy")
  reviewedAssistantshipApplications AssistantshipApplication[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AcademicImportType {
  PROJECTS
  RESEARCH
  HOURLY
  CURRICULUM
}

enum AcademicImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DataRightsRequestType {
  ACCESS
  RECTIFICATION
  SUPPRESSION
  OPPOSITION
  PORTABILITY
  BLOCKING
}

enum DataRightsRequestStatus {
  RECEIVED
  VERIFYING
  IN_PROGRESS
  COMPLETED
  DENIED
  CLOSED
}

enum DataRightsRequestEventType {
  SUBMITTED
  STATUS_CHANGED
  DEADLINE_EXTENDED
}

model DataRightsRequest {
  id            String                   @id @default(uuid())
  subjectUserId String?
  rightType     DataRightsRequestType
  status        DataRightsRequestStatus  @default(RECEIVED)
  details       String?                  @db.Text
  responseNote  String?                  @db.Text
  dueAt         DateTime
  extendedAt    DateTime?
  extensionNote String?                  @db.Text
  respondedAt   DateTime?
  piiVersion    Int                      @default(0)
  subject       User?                    @relation("DataRightsSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  events        DataRightsRequestEvent[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  closedAt      DateTime?

  @@index([subjectUserId, createdAt])
  @@index([status, dueAt])
}

model DataRightsRequestEvent {
  id         String                     @id @default(uuid())
  requestId  String
  actorId    String?
  eventType  DataRightsRequestEventType
  fromStatus DataRightsRequestStatus?
  toStatus   DataRightsRequestStatus
  request    DataRightsRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User?                      @relation("DataRightsActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime                   @default(now())

  @@index([requestId, createdAt])
}

model LegalTermsAcceptance {
  id              String   @id @default(uuid())
  userId          String
  version         String
  locale          String
  contentHash     String
  contentSnapshot Json
  acceptedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId, acceptedAt])
}

/// Durable academic import queue; the workbook payload is application-encrypted.
model AcademicImportJob {
  id            String               @id @default(uuid())
  type          AcademicImportType
  status        AcademicImportStatus @default(QUEUED)
  payload       String?              @db.Text
  result        Json?
  error         String?              @db.Text
  requestedById String
  attempts      Int                  @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
}

enum JustificationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum JustificationInboxStatus {
  UNREAD
  READ
}

enum CourseAttemptOutcome {
  PASSED
  FAILED
}

enum SemesterBudgetCategoryCode {
  HOURLY_TEACHERS
  ASSISTANTSHIPS
}

enum TitulationStage {
  UNCLASSIFIED
  INTAKE
  REVIEW
  DEFENSE
  CLOSED
}

enum TitulationDocumentStatus {
  UNVERIFIED
  PENDING
  RECEIVED
  PREPARED
}

enum TitulationOutcome {
  UNCONFIRMED
  IN_PROGRESS
  GRADUATED
  NOT_GRADUATED
}

enum TitulationDataSource {
  MANUAL
  LEGACY_ACCESS
}

model AcademicSemester {
  id                   String                 @id @default(uuid())
  name                 String
  startsOn             DateTime
  endsOn               DateTime
  isActive             Boolean                @default(false)
  assignments          TeachingAssignment[]
  courseSchedules      CourseSchedule[]
  studentEnrollments   StudentEnrollment[]
  courseAttempts       StudentCourseAttempt[]
  hourlyPayRates       HourlyPayRate[]
  assistantships       Assistantship[]
  assistantshipTariffs AssistantshipTariff[]
  budget               SemesterBudget?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([name])
  @@index([isActive])
}

/// Planned CLP budget for a semester. Thresholds track distributed category budgets.
model SemesterBudget {
  id             String                     @id @default(uuid())
  semesterId     String                     @unique
  totalAmountClp Decimal                    @db.Decimal(14, 0)
  semester       AcademicSemester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  allocations    SemesterBudgetAllocation[]
  thresholds     SemesterBudgetThreshold[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
}

model SemesterBudgetAllocation {
  id        String                      @id @default(uuid())
  budgetId  String
  name      String                      @db.VarChar(80)
  code      SemesterBudgetCategoryCode?
  amountClp Decimal                     @db.Decimal(14, 0)
  budget    SemesterBudget              @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@unique([budgetId, name])
  @@unique([budgetId, code])
  @@index([budgetId])
}

model SemesterBudgetThreshold {
  id             String                        @id @default(uuid())
  budgetId       String
  percentage     Int
  budget         SemesterBudget                @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  recipientRoles SemesterBudgetThresholdRole[]
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@unique([budgetId, percentage])
  @@index([budgetId])
}

model SemesterBudgetThresholdRole {
  thresholdId String
  roleId      String
  threshold   SemesterBudgetThreshold @relation(fields: [thresholdId], references: [id], onDelete: Cascade)
  role        Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedAt  DateTime                @default(now())

  @@id([thresholdId, roleId])
  @@index([roleId])
}

model Teacher {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion       Int     @default(0)
  emailHash        String? @unique
  employeeCodeHash String? @unique
  rutHash          String? @unique

  id                     String                 @id @default(uuid())
  name                   String
  email                  String                 @unique
  employeeCode           String?                @unique
  rut                    String?                @unique
  academicUnit           String?
  academicDegree         AcademicDegree?
  certification          TeacherCertification?
  professionalTitle      String?
  institution            String?
  projectParticipations  ProjectParticipant[]
  researchParticipations ResearchParticipant[]
  outputAuthorships      ResearchOutputAuthor[]
  isActive               Boolean                @default(true)
  joinedOn               DateTime?              @db.Date
  leftOn                 DateTime?              @db.Date
  assignments            TeachingAssignment[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model Course {
  id                 String                    @id @default(uuid())
  code               String?
  name               String
  assignments        TeachingAssignment[]
  schedules          CourseSchedule[]
  assistantApprovals AssistantCourseApproval[]
  studentEnrollments StudentEnrollment[]
  curriculumCourses  CurriculumCourse[]
  courseAttempts     StudentCourseAttempt[]
  assistantships     Assistantship[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([code, name])
}

/// Academic students are independent from administrative login accounts.
model Student {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int     @default(0)
  emailHash  String? @unique

  id                        String                 @id @default(uuid())
  name                      String
  email                     String?                @unique
  givenNames                String?
  rut                       String?
  rutHash                   String?                @unique
  personalEmail             String?
  admission                 String?
  paternalSurname           String?
  maternalSurname           String?
  birthDate                 String?
  careerId                  String?
  career                    Career?                @relation(fields: [careerId], references: [id], onDelete: Restrict)
  enrollments               StudentEnrollment[]
  careerCurriculumVersionId String?
  careerCurriculumVersion   CurriculumVersion?     @relation(fields: [careerCurriculumVersionId], references: [id], onDelete: Restrict)
  courseAttempts            StudentCourseAttempt[]
  justificationInbox        JustificationInbox[]
  justifications            Justification[]
  outputAuthorships         ResearchOutputAuthor[]
  teachingAssistant         TeachingAssistant?
  assistantshipApplications AssistantshipApplication[]
  titulationProcesses       TitulationProcess[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([careerId])
}

/// A student attends an NRC in a semester, independently of teachers or time slots.
model StudentEnrollment {
  id         String           @id @default(uuid())
  studentId  String
  semesterId String
  courseId   String
  nrc        String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  semester   AcademicSemester @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())

  @@unique([studentId, semesterId, nrc])
  @@index([semesterId, nrc])
  @@index([courseId])
}

/// A student's result for one course in a particular semester. Repeated
/// attempts are retained and numbered; they are independent from editable rosters.
model StudentCourseAttempt {
  id            String               @id @default(uuid())
  studentId     String
  semesterId    String
  courseId      String
  attemptNumber Int
  outcome       CourseAttemptOutcome
  nrc           String?
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  semester      AcademicSemester     @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  course        Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now())

  @@unique([studentId, courseId, attemptNumber])
  @@index([studentId, semesterId])
  @@index([courseId])
}

model Department {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String?          @unique
  description String?
  careers     Career[]
  projects    Project[]
  outputs     ResearchOutput[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

/// A career groups one or more curricula assigned to student cohorts.
model Career {
  id                  String              @id @default(uuid())
  code                String?             @unique
  name                String              @unique
  isActive            Boolean             @default(true)
  departmentId        String?
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  curriculumVersions  CurriculumVersion[]
  students            Student[]
  assistantships      Assistantship[]
  titulationProcesses TitulationProcess[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([departmentId])
}

model TitulationProcess {
  id                   String                   @id @default(uuid())
  studentId            String?
  student              Student?                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  piiVersion           Int                      @default(0)
  studentName          String
  studentRut           String?
  studentRutHash       String?
  studentEmail         String?
  studentEmailHash     String?
  studentPhone         String?
  thesisTopic          String?                  @db.Text
  degree               String?
  careerName           String
  careerId             String?
  guideName            String?
  coGuideName          String?
  reviewerOneName      String?
  reviewerTwoName      String?
  defenseDate          DateTime?                @db.Date
  stage                TitulationStage          @default(INTAKE)
  outcome              TitulationOutcome        @default(IN_PROGRESS)
  source               TitulationDataSource    @default(MANUAL)
  defenseAnnexesStatus TitulationDocumentStatus @default(PENDING)
  thesisSummaryStatus  TitulationDocumentStatus @default(PENDING)
  libraryFormStatus    TitulationDocumentStatus @default(PENDING)
  actaStatus           TitulationDocumentStatus @default(PENDING)
  evaluationsStatus    TitulationDocumentStatus @default(PENDING)
  createdById          String?
  updatedById          String?
  career               Career?                  @relation(fields: [careerId], references: [id], onDelete: SetNull)
  createdBy            User?                    @relation("TitulationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                    @relation("TitulationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attachments          TitulationAttachment[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([stage, defenseDate])
  @@index([careerId, stage])
  @@index([studentRutHash])
  @@index([studentEmailHash])
  @@index([studentId])
  @@index([outcome, stage])
  @@index([createdAt])
}

model TitulationAttachment {
  id           String            @id @default(uuid())
  processId    String
  storageKey   String            @unique
  originalName String            @db.VarChar(255)
  contentType  String            @db.VarChar(128)
  size         Int
  createdById  String?
  process      TitulationProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("TitulationAttachmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([processId, createdAt])
  @@index([createdById])
}

/// Curriculum version applied to an admission cohort; versions remain stable
/// so historical student progress keeps its original course requirements.
model CurriculumVersion {
  id         String             @id @default(uuid())
  careerId   String
  cohortYear Int
  career     Career             @relation(fields: [careerId], references: [id], onDelete: Restrict)
  students   Student[]
  courses    CurriculumCourse[]
  createdAt  DateTime           @default(now())

  @@unique([careerId, cohortYear])
  @@index([careerId])
}

/// A global course included in one version of a career's curriculum.
model CurriculumCourse {
  id                  String            @id @default(uuid())
  curriculumVersionId String
  courseId            String
  termNumber          Int
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([curriculumVersionId, courseId])
  @@index([courseId])
}

model TeachingAssignment {
  id              String                   @id @default(uuid())
  semesterId      String
  teacherId       String
  courseId        String
  nrc             String                   @default("")
  /// Deprecated: retained only for historical data. New imports use nrc.
  parallel        String                   @default("")
  semester        AcademicSemester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  teacher         Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt       DateTime                 @default(now())
  assistantships  Assistantship[]
  hourlyContracts HourlyTeachingContract[]

  // Composite reference ensures an assistantship uses this assignment's course.
  @@unique([id, courseId])
  @@unique([id, semesterId])
  @@unique([semesterId, teacherId, courseId, nrc])
  @@index([semesterId])
  @@index([teacherId])
  @@index([nrc])
}

/// Assistant profile linked to the global academic student; legacy links may be absent.
model TeachingAssistant {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion      Int     @default(0)
  emailHash       String? @unique
  studentCodeHash String? @unique

  id          String                    @id @default(uuid())
  studentId   String?                   @unique
  student     Student?                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  name        String
  email       String                    @unique
  studentCode String?                   @unique
  isActive    Boolean                   @default(true)
  approvals   AssistantCourseApproval[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

/// Records an already passed course, independently of its NRC in each semester.
model AssistantCourseApproval {
  assistantId    String
  courseId       String
  approvedOn     DateTime          @db.Date
  assistant      TeachingAssistant @relation(fields: [assistantId], references: [id], onDelete: Restrict)
  course         Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assistantships Assistantship[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@id([assistantId, courseId])
  // Supports a foreign key that keeps the approval date consistent in assignments.
  @@unique([assistantId, courseId, approvedOn])
  @@index([courseId])
}

/// Semester and course remain queryable without a historical teaching assignment.
/// nrc identifies the assistantship itself and can differ from the course NRC.
model Assistantship {
  id                   String                  @id @default(uuid())
  nrc                  String?
  teachingAssignmentId String?
  semesterId           String
  careerId             String?
  courseNrc            String?
  assistantId          String
  courseId             String
  /// Must match the approval record; SQL checks approval precedes startsOn.
  approvedOn           DateTime                @db.Date
  startsOn             DateTime                @db.Date
  endsOn               DateTime?               @db.Date
  weeklyHours          Decimal?                @db.Decimal(5, 2)
  tariffId             String?
  tariffRateClp        Decimal?                @db.Decimal(12, 2)
  tariff               AssistantshipTariff?    @relation(fields: [tariffId, semesterId], references: [id, semesterId], onDelete: Restrict)
  teachingAssignment   TeachingAssignment?     @relation(fields: [teachingAssignmentId, courseId], references: [id, courseId], onDelete: Restrict)
  semester             AcademicSemester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  course               Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  career               Career?                 @relation(fields: [careerId], references: [id], onDelete: Restrict)
  approval             AssistantCourseApproval @relation(fields: [assistantId, courseId, approvedOn], references: [assistantId, courseId, approvedOn], onDelete: Restrict)
  schedules            AssistantshipSchedule[]
  application          AssistantshipApplication?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([teachingAssignmentId, assistantId])
  @@index([assistantId, courseId, approvedOn])
  @@index([teachingAssignmentId, courseId])
  @@index([semesterId, courseId])
}

enum AssistantshipApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssistantshipApplicationNotification {
  NOT_REQUESTED
  PENDING
  SENT
  FAILED
}

/// An approved application is the draft until a complete assistantship is registered.
model AssistantshipApplication {
  id                     String                             @id @default(uuid())
  piiVersion             Int                                @default(0)
  externalResponseId     String
  externalResponseIdHash String?                            @unique
  studentEmail           String
  name                   String
  rut                    String
  phone                  String
  submittedCareer        String
  address                String
  subject                String
  motivation             String
  ppa                    String
  submittedAt            DateTime
  status                 AssistantshipApplicationStatus    @default(PENDING)
  reviewNote             String?
  reviewedAt             DateTime?
  reviewedById           String?
  reviewedBy             User?                              @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  notification           AssistantshipApplicationNotification @default(NOT_REQUESTED)
  studentId              String?
  student                Student?                           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  assistantshipId        String?                            @unique
  assistantship          Assistantship?                     @relation(fields: [assistantshipId], references: [id], onDelete: Restrict)
  createdAt              DateTime                           @default(now())

  @@index([status, submittedAt, id])
  @@index([studentId])
}

/// Monthly CLP rate per weekly assistantship hour.
model AssistantshipTariff {
  id             String           @id @default(uuid())
  semesterId     String
  name           String           @db.VarChar(80)
  monthlyRateClp Decimal          @db.Decimal(12, 2)
  semester       AcademicSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  assistantships Assistantship[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([id, semesterId])
  @@unique([semesterId, name])
  @@index([semesterId])
}

/// Weekly schedule in local campus time; weekdays follow ISO 8601 (1–7).
model AssistantshipSchedule {
  id              String        @id @default(uuid())
  assistantshipId String
  weekday         Int
  startsAtMinute  Int
  endsAtMinute    Int
  location        String?
  assistantship   Assistantship @relation(fields: [assistantshipId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([assistantshipId, weekday, startsAtMinute, endsAtMinute])
}

model CourseSchedule {
  id         String           @id @default(uuid())
  semesterId String
  courseId   String
  nrc        String
  day        String
  block      String
  location   String?
  semester   AcademicSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([semesterId, nrc, day, block])
  @@index([semesterId])
  @@index([nrc])
}

model JustificationInbox {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion             Int     @default(0)
  externalResponseIdHash String? @unique
  studentEmailHash       String?

  id                  String                   @id @default(uuid())
  externalResponseId  String                   @unique
  studentEmail        String
  studentId           String?
  student             Student?                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  absenceDate         DateTime
  absenceBlocks       String[]                 @default([])
  subjectName         String
  subjectCode         String?
  nrc                 String?
  reasonCategory      String?
  /// Deprecated: retained for historical submissions.
  parallel            String?
  reason              String?
  evidenceKey         String
  evidenceContentType String
  status              JustificationInboxStatus @default(UNREAD)
  readAt              DateTime?
  justificationId     String?                  @unique
  justification       Justification?           @relation(fields: [justificationId], references: [id])
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([studentEmailHash])
  @@index([status, createdAt])
  @@index([studentId])
}

model Justification {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion           Int     @default(0)
  sourceResponseIdHash String? @unique
  studentEmailHash     String?

  id                  String                       @id @default(uuid())
  sourceResponseId    String                       @unique
  studentEmail        String
  studentId           String?
  student             Student?                     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  absenceDate         DateTime
  absenceBlocks       String[]                     @default([])
  subjectName         String
  subjectCode         String?
  nrc                 String?
  reasonCategory      String?
  /// Deprecated: retained for historical submissions.
  parallel            String?
  reason              String?
  evidenceKey         String
  evidenceContentType String
  status              JustificationStatus          @default(PENDING)
  rejectionReason     String?
  openedAt            DateTime                     @default(now())
  decidedAt           DateTime?
  createdById         String
  decidedById         String?
  createdBy           User                         @relation("JustificationCreatedBy", fields: [createdById], references: [id])
  decidedBy           User?                        @relation("JustificationDecidedBy", fields: [decidedById], references: [id])
  inboxEntry          JustificationInbox?
  history             JustificationStatusHistory[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([studentEmailHash])
  @@index([status, createdAt])
  @@index([studentEmail])
  @@index([studentId])
}

model JustificationStatusHistory {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int @default(0)

  id              String               @id @default(uuid())
  justificationId String
  fromStatus      JustificationStatus?
  toStatus        JustificationStatus
  note            String?
  changedById     String
  justification   Justification        @relation(fields: [justificationId], references: [id], onDelete: Cascade)
  changedBy       User                 @relation(fields: [changedById], references: [id])
  createdAt       DateTime             @default(now())

  @@index([justificationId, createdAt])
}

model Role {
  id                    String                        @id @default(uuid())
  code                  String                        @unique
  name                  String                        @unique
  description           String?
  isSystem              Boolean                       @default(false)
  userRoles             UserRole[]
  preloads              PreloadedUserRole[]
  permissions           RolePermission[]
  budgetAlertThresholds SemesterBudgetThresholdRole[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PreloadedUser {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int     @default(0)
  emailHash  String? @unique

  id        String              @id @default(uuid())
  email     String              @unique
  createdAt DateTime            @default(now())
  roles     PreloadedUserRole[]
}

model PreloadedUserRole {
  preloadedUserId String
  roleId          String
  assignedAt      DateTime @default(now())

  preloadedUser PreloadedUser @relation(fields: [preloadedUserId], references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([preloadedUserId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum AcademicDegree {
  PROFESSIONAL
  MASTER
  DOCTOR
  NOT_APPLICABLE
}

enum TeacherCertification {
  NONE
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum HourlyTeacherCategory {
  NEW
  EXISTING
  DIVING_PRINCIPAL
  DIVING_SECONDARY
}

enum TeachingComponent {
  LECTURE
  WORKSHOP
  LABORATORY
  FIELDWORK
  ASSISTANTSHIP
}

/// Configurable CLP monthly payment per direct teaching hour, per semester.
model HourlyPayRate {
  id             String                   @id @default(uuid())
  semesterId     String
  category       HourlyTeacherCategory
  academicDegree AcademicDegree
  certification  TeacherCertification
  hourlyRateClp  Decimal                  @db.Decimal(12, 2)
  semester       AcademicSemester         @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  contracts      HourlyTeachingContract[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([id, semesterId])
  @@unique([semesterId, category, academicDegree, certification])
}

/// A component/parallel of a semester assignment. Snapshots preserve historical pay.
model HourlyTeachingContract {
  id                   String             @id @default(uuid())
  semesterId           String
  teachingAssignmentId String
  payRateId            String
  component            TeachingComponent
  parallel             String
  directHours          Decimal            @db.Decimal(5, 2)
  startsOn             DateTime           @db.Date
  endsOn               DateTime           @db.Date
  hourlyRateClp        Decimal            @db.Decimal(12, 2)
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId, semesterId], references: [id, semesterId], onDelete: Restrict)
  payRate              HourlyPayRate      @relation(fields: [payRateId, semesterId], references: [id, semesterId], onDelete: Restrict)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([teachingAssignmentId, component, parallel])
  @@index([semesterId])
  @@index([payRateId, semesterId])
}

enum ProjectStatus {
  REGISTERED
  AWARDED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

/// General register: research, training, services, agreements and academic programs.
model Project {
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction)

  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int @default(0)

  id                  String                  @id @default(uuid())
  reportingYear       Int
  academicUnit        String
  faculty             String?
  resolution          String?
  code                String?                 @unique
  title               String
  classification      String?
  fundingSource       String?
  program             String?
  competition         String?
  applicationArea     String?
  participationScope  String?
  status              ProjectStatus           @default(REGISTERED)
  officialized        Boolean?
  startsOn            DateTime?               @db.Date
  endsOn              DateTime?               @db.Date
  revisedEndsOn       DateTime?               @db.Date
  closedOn            DateTime?               @db.Date
  currency            String?
  totalAmount         Decimal?                @db.Decimal(18, 2)
  vraContribution     Decimal?                @db.Decimal(18, 2)
  vridtContribution   Decimal?                @db.Decimal(18, 2)
  recoveryAmount      Decimal?                @db.Decimal(18, 2)
  facultyContribution Decimal?                @db.Decimal(18, 2)
  depreciationAmount  Decimal?                @db.Decimal(18, 2)
  profitabilityAmount Decimal?                @db.Decimal(18, 2)
  folderUrl           String?
  notes               String?
  participants        ProjectParticipant[]
  research            Research?
  outputs             ResearchOutputProject[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([departmentId])
  @@index([reportingYear, academicUnit])
  @@index([status])
}

/// Named external participants can be recorded without creating a teacher account.
model ProjectParticipant {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int     @default(0)
  nameHash   String?

  id           String   @id @default(uuid())
  projectId    String
  teacherId    String?
  name         String
  role         String
  contactEmail String?
  gender       String?
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teacher      Teacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([projectId, nameHash, role])
  @@unique([projectId, name, role])
  @@index([nameHash])
  @@index([teacherId])
}

/// Research activity can be linked to a funded project or registered independently.
model Research {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int @default(0)

  id           String                @id @default(uuid())
  projectId    String?               @unique
  code         String?               @unique
  title        String
  description  String?
  academicUnit String
  researchArea String?
  startsOn     DateTime?             @db.Date
  endsOn       DateTime?             @db.Date
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  participants ResearchParticipant[]
  outputs      ResearchOutput[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([academicUnit])
}

model ResearchParticipant {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int     @default(0)
  nameHash   String?

  id         String   @id @default(uuid())
  researchId String
  teacherId  String?
  name       String
  role       String
  research   Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  teacher    Teacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([researchId, nameHash, role])
  @@unique([researchId, name, role])
  @@index([nameHash])
  @@index([teacherId])
}

enum ResearchOutputKind {
  ARTICLE
  BOOK
  BOOK_CHAPTER
  INTELLECTUAL_PROPERTY
}

model ResearchOutput {
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction)

  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int @default(0)

  id                         String                  @id @default(uuid())
  researchId                 String?
  kind                       ResearchOutputKind
  reportingYear              Int
  title                      String
  doi                        String?                 @unique
  journal                    String?
  issn                       String?
  isbn                       String?
  quartile                   String?
  fiveYearImpactFactor       Decimal?                @db.Decimal(10, 4)
  publicationDate            DateTime?               @db.Date
  indexation                 String?
  publisher                  String?
  publicationPlace           String?
  studentParticipation       Boolean?
  internationalParticipation Boolean?
  intellectualPropertyType   String?
  phase                      String?
  phaseDate                  DateTime?               @db.Date
  notes                      String?
  research                   Research?               @relation(fields: [researchId], references: [id], onDelete: Restrict)
  authors                    ResearchOutputAuthor[]
  projects                   ResearchOutputProject[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([departmentId])
  @@index([reportingYear, kind])
  @@index([researchId])
}

model ResearchOutputAuthor {
  /// Application-encrypted PII; version 0 requires the offline backfill.
  piiVersion Int @default(0)

  id          String         @id @default(uuid())
  outputId    String
  teacherId   String?
  studentId   String?
  name        String
  position    Int
  affiliation String?
  isStudent   Boolean?
  output      ResearchOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  teacher     Teacher?       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  student     Student?       @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([outputId, position])
  @@index([teacherId])
  @@index([studentId])
}

/// A publication can acknowledge several projects, as in the EPRYMA workbook.
model ResearchOutputProject {
  outputId  String
  projectId String
  output    ResearchOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@id([outputId, projectId])
  @@index([projectId])
}
