# Runtime configuration. Dokploy injects these into the backend Application.
# Development may load .env.pii + .env.development; never bake either into Docker.
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=
# Prisma migrations use DIRECT_URL when set. It must target the SAME database.
DIRECT_URL=
# Optional, isolated SQL integration tests only; never use production.
TEST_DATABASE_URL=
ACADEMIC_TIME_ZONE=America/Santiago

# Production requires Redis. URL must include credentials when configured.
CACHE_TYPE=memory
REDIS_URL=

# Generate fresh independent keys for a NEW database with scripts/create-pii-keys.mjs.
# Preserve the original keys when restoring an encrypted database.
PII_ACTIVE_KEY_ID=
# JSON object mapping key identifiers to independent 32-byte base64 keys.
PII_ENCRYPTION_KEYS=
PII_BLIND_INDEX_KEY=
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# At least one whitelist must be configured; comma-separated, no @ in domains.
ALLOWED_DOMAINS=
ALLOWED_EMAILS=
NO_ACCESS_ROUTE=/no-access
# Offline bootstrap command only; never automatically promotes Google accounts.
BOOTSTRAP_ADMIN_EMAIL=
# Optional trusted proxy CIDRs/IPs, comma-separated. Empty means trust none.
# Use the actual Traefik network, never an unrestricted true value.
TRUST_PROXY=

GOOGLE_FORMS_WEBHOOK_SECRET=
RESEND_API_KEY=
NOTIFICATIONS_FROM=

# r2 | s3 | minio | none. Production readiness requires a configured private bucket.
STORAGE_PROVIDER=none
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGNED_URL_EXPIRES_IN=900

# S3/MinIO: internal endpoint handles HeadObject/HeadBucket; PUBLIC endpoint signs
# browser/Apps Script URLs and must retain the signed host and path, with HTTPS in production.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGNED_URL_EXPIRES_IN=900

# Local multi-repo Compose only. Native Dokploy PostgreSQL/Redis use their own secrets.
DB_USER=marsys
DB_PASSWORD=
DB_NAME=marsys
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Explicitly select reviewed image/digest; archived Community is for tests only.
MINIO_IMAGE=
MC_IMAGE=
NGINX_HTTP_PORT=80
S3_TEST_PORT=19000
