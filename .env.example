# ==============================================================================
# AMBIENTE 1: DESARROLLO (npm run start:dev)
# ==============================================================================
# IMPORTANTE: Para trabajar localmente, copia este archivo como ".env.development"
# NODE_ENV="development"
# DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require"
# STORAGE_PROVIDER="r2"
# R2_ACCOUNT_ID="tu_account_id_de_cloudflare"
# R2_ACCESS_KEY_ID="tu_access_key"
# R2_SECRET_ACCESS_KEY="tu_secret_key"
# R2_BUCKET_NAME="msms-dev-bucket"
# CACHE_TYPE="memory"

# ==============================================================================
# AMBIENTE 2 & 3: PRE-PRODUCCIÓN Y PRODUCCIÓN (docker-compose)
# ==============================================================================
# IMPORTANTE: Para docker-compose, copia este archivo como ".env" (sin extensión)
# NODE_ENV="preproduction" # Cambiar a "production" en Producción

# -- Base de Datos (Docker) --
# DB_USER="user"
# DB_PASSWORD="password"
# DB_NAME="msms_db"
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?schema=public"

# -- Almacenamiento de Objetos (MinIO - Pre-Prod y Prod) --
# STORAGE_PROVIDER="minio"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET_NAME="msms-bucket"
# NEXT_PUBLIC_STORAGE_URL="/storage" # Como usamos NGINX, la URL es relativa

# -- Caché (Redis en Docker) --
# CACHE_TYPE="redis"
# REDIS_URL="redis://redis:6379"

# -- NGINX Puertos Externos --
# El único puerto expuesto a tu máquina física será el de NGINX, evitando choques con Node local
# NGINX_HTTP_PORT=8080
# NGINX_HTTPS_PORT=8443
