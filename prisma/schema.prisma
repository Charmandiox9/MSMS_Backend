// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  avatarUrl     String?
  
  // Google OAuth specific
  googleId      String?    @unique
  
  // Los roles y permisos son configurables y se asignan mediante relaciones RBAC.
  userRoles     UserRole[]
  createdJustifications Justification[] @relation("JustificationCreatedBy")
  decidedJustifications Justification[] @relation("JustificationDecidedBy")
  justificationHistory JustificationStatusHistory[]
  
  isActive      Boolean    @default(true)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum JustificationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum JustificationInboxStatus {
  UNREAD
  READ
}

model AcademicSemester {
  id          String   @id @default(uuid())
  name        String
  startsOn    DateTime
  endsOn      DateTime
  isActive    Boolean  @default(false)
  assignments TeachingAssignment[]
  courseSchedules CourseSchedule[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@unique([name])
}

model Teacher {
  id           String               @id @default(uuid())
  name         String
  email        String               @unique
  employeeCode String?              @unique
  isActive     Boolean              @default(true)
  joinedOn     DateTime?            @db.Date
  leftOn       DateTime?            @db.Date
  assignments  TeachingAssignment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Course {
  id                 String                    @id @default(uuid())
  code               String?
  name               String
  assignments        TeachingAssignment[]
  schedules          CourseSchedule[]
  assistantApprovals AssistantCourseApproval[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([code, name])
}

model TeachingAssignment {
  id             String           @id @default(uuid())
  semesterId     String
  teacherId      String
  courseId       String
  nrc            String           @default("")
  /// Deprecated: retained only for historical data. New imports use nrc.
  parallel       String           @default("")
  semester       AcademicSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  assistantships Assistantship[]

  // Composite reference ensures an assistantship uses this assignment's course.
  @@unique([id, courseId])
  @@unique([semesterId, teacherId, courseId, nrc])
  @@index([semesterId])
  @@index([teacherId])
}

/// Academic student record; independent from administrative login accounts.
model TeachingAssistant {
  id          String                    @id @default(uuid())
  name        String
  email       String                    @unique
  studentCode String?                   @unique
  isActive    Boolean                   @default(true)
  approvals   AssistantCourseApproval[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

/// Records an already passed course, independently of its NRC in each semester.
model AssistantCourseApproval {
  assistantId    String
  courseId       String
  approvedOn     DateTime          @db.Date
  assistant      TeachingAssistant @relation(fields: [assistantId], references: [id], onDelete: Restrict)
  course         Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assistantships Assistantship[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@id([assistantId, courseId])
  // Supports a foreign key that keeps the approval date consistent in assignments.
  @@unique([assistantId, courseId, approvedOn])
  @@index([courseId])
}

/// Semester, course NRC and supervising teacher come from the teaching assignment.
/// nrc identifies the assistantship itself and can differ from the course NRC.
model Assistantship {
  id                   String                  @id @default(uuid())
  nrc                  String?
  teachingAssignmentId String
  assistantId          String
  courseId             String
  /// Must match the approval record; SQL checks approval precedes startsOn.
  approvedOn           DateTime                @db.Date
  startsOn             DateTime                @db.Date
  endsOn               DateTime?               @db.Date
  weeklyHours          Decimal?                @db.Decimal(5, 2)
  teachingAssignment   TeachingAssignment      @relation(fields: [teachingAssignmentId, courseId], references: [id, courseId], onDelete: Restrict)
  approval             AssistantCourseApproval @relation(fields: [assistantId, courseId, approvedOn], references: [assistantId, courseId, approvedOn], onDelete: Restrict)
  schedules            AssistantshipSchedule[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([teachingAssignmentId, assistantId])
  @@index([assistantId, courseId, approvedOn])
  @@index([teachingAssignmentId, courseId])
}

/// Weekly schedule in local campus time; weekdays follow ISO 8601 (1–7).
model AssistantshipSchedule {
  id              String        @id @default(uuid())
  assistantshipId String
  weekday         Int
  startsAtMinute  Int
  endsAtMinute    Int
  location        String?
  assistantship   Assistantship @relation(fields: [assistantshipId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([assistantshipId, weekday, startsAtMinute, endsAtMinute])
}

model CourseSchedule {
  id         String           @id @default(uuid())
  semesterId String
  courseId   String
  nrc        String
  day        String
  block      String
  location   String?
  semester   AcademicSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([semesterId, nrc, day, block])
  @@index([semesterId])
  @@index([nrc])
}

model JustificationInbox {
  id                 String                    @id @default(uuid())
  externalResponseId String                    @unique
  studentEmail       String
  absenceDate        DateTime
  absenceBlocks      String[]                  @default([])
  subjectName        String
  subjectCode        String?
  nrc                String?
  reasonCategory     String?
  /// Deprecated: retained for historical submissions.
  parallel           String?
  reason             String?
  evidenceKey        String
  evidenceContentType String
  status             JustificationInboxStatus  @default(UNREAD)
  readAt             DateTime?
  justificationId    String?                   @unique
  justification      Justification?            @relation(fields: [justificationId], references: [id])
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([status, createdAt])
}

model Justification {
  id                  String                 @id @default(uuid())
  sourceResponseId    String                 @unique
  studentEmail        String
  absenceDate         DateTime
  absenceBlocks       String[]               @default([])
  subjectName         String
  subjectCode         String?
  nrc                 String?
  reasonCategory      String?
  /// Deprecated: retained for historical submissions.
  parallel            String?
  reason              String?
  evidenceKey         String
  evidenceContentType String
  status              JustificationStatus    @default(PENDING)
  rejectionReason     String?
  openedAt            DateTime               @default(now())
  decidedAt           DateTime?
  createdById         String
  decidedById         String?
  createdBy           User                   @relation("JustificationCreatedBy", fields: [createdById], references: [id])
  decidedBy           User?                  @relation("JustificationDecidedBy", fields: [decidedById], references: [id])
  inboxEntry          JustificationInbox?
  history             JustificationStatusHistory[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([studentEmail])
}

model JustificationStatusHistory {
  id              String              @id @default(uuid())
  justificationId String
  fromStatus      JustificationStatus?
  toStatus        JustificationStatus
  note            String?
  changedById     String
  justification   Justification       @relation(fields: [justificationId], references: [id], onDelete: Cascade)
  changedBy       User                @relation(fields: [changedById], references: [id])
  createdAt       DateTime            @default(now())

  @@index([justificationId, createdAt])
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  userRoles   UserRole[]
  preloads    PreloadedUserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PreloadedUser {
  id        String               @id @default(uuid())
  email     String               @unique
  createdAt DateTime             @default(now())
  roles     PreloadedUserRole[]
}

model PreloadedUserRole {
  preloadedUserId String
  roleId          String
  assignedAt      DateTime      @default(now())

  preloadedUser PreloadedUser @relation(fields: [preloadedUserId], references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([preloadedUserId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}
